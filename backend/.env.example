PORT=5000
MONGO_URI=mongodb://localhost:27017/noble_rain
JWT_SECRET=change_this_to_a_long_random_secret
NODE_ENV=development

# Comma-separated list of allowed frontend origins, e.g.
# https://noblerain.com,https://www.noblerain.com
# Leave unset in local dev - the API is left open to any origin so the
# Vite dev server's proxy keeps working without extra setup. Set this
# before going to production.
CORS_ORIGIN=

# --- Courier API Credentials ---
# Steadfast Credentials
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=
STEADFAST_WEBHOOK_SECRET=

# Pathao Credentials
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_BASE_URL=

# --- Google API (Gmail send + Sheets/Drive reports + "Sign in with Google") ---
# GOOGLE_CLIENT_ID must be a Google Cloud OAuth "Web application" client with
# your frontend origin under Authorized JavaScript origins (for Sign in with
# Google) and http://localhost:5000/auth/google/callback under Authorized
# redirect URIs (for the Gmail/Sheets refresh-token flow). The same client ID
# also goes in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
